{
  /* Compiles src/server.ts and the /api/custom-rss handler tests for Node's
     built-in test runner (`npm run test:server`). The output lives inside the
     gitignored node_modules directory and is never shipped. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./node_modules/.server-test-build",
    "types": ["node"]
  },
  "include": [
    "src/server.ts",
    "src/openrouter-client.ts",
    "server-tests/**/*.ts"
  ]
}
